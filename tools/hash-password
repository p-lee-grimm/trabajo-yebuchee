#!/usr/bin/env python3
"""Print a password_hash line for config.yaml (auth: password).

    venv/bin/python tools/hash-password >> config.yaml

The password is read without echo and never stored; config.yaml keeps only a salted
scrypt hash. Changing the password logs out every open session.
"""
import getpass
import hashlib
import secrets
import sys

N, R, P = 2 ** 14, 8, 1

first = getpass.getpass("Пароль / Password: ")
if len(first) < 10:
    sys.exit("Нужно не меньше 10 символов / at least 10 characters")
if getpass.getpass("Ещё раз / Again: ") != first:
    sys.exit("Не совпадает / Does not match")
salt = secrets.token_bytes(16)
digest = hashlib.scrypt(first.encode(), salt=salt, n=N, r=R, p=P)
print(f"password_hash: scrypt${N}${R}${P}${salt.hex()}${digest.hex()}")
